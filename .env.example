# Documentation template; npm scripts use the current process environment.
# To load this file explicitly: node --env-file=.env dist/server/index.js
HUB_HOST=127.0.0.1
HUB_PORT=3000
HUB_DATA_DIR=./data
# Required when binding a non-loopback address. Origin only, no trailing slash.
# HUB_PUBLIC_URL=https://hub.example.com
# Optional defaults for the client CLI:
# AGENT_HUB_SERVER=https://hub.example.com
# AGENT_HUB_USER=alice
# Do not store passwords in this file.
